# Queue Rorschach environment variables
# Copy this file to .env.local and fill in the values you need.
# Most variables are optional; the app can run with deterministic fallbacks.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Base URL used to build shareable report links.
# For local development, this can usually stay as http://localhost:3000.
APP_URL=http://localhost:3000

# Optional public app URL for client-side components.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional app display name.
# NEXT_PUBLIC_APP_TITLE=Queue Rorschach

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------

# LLM provider used by lib/llm.js.
# Supported values:
#   openai      - OpenAI or any OpenAI-compatible API
#   anthropic   - Anthropic Claude API
#   mock        - deterministic local fallback, no API key required
#
# If LLM_API_KEY is missing, the app will fall back to deterministic output
# so local development and tests can run without external services.
LLM_PROVIDER=openai

# API key for the selected LLM provider.
# Leave blank to use the deterministic fallback.
LLM_API_KEY=

# Base URL for the LLM API.
# For OpenAI-compatible providers, point this at your provider endpoint.
LLM_BASE_URL=https://api.openai.com/v1

# Model name to use for story generation and copy rewrites.
LLM_MODEL=gpt-4o-mini

# Sampling temperature.
# Lower values are more deterministic; higher values are more creative.
LLM_TEMPERATURE=0.7

# Maximum tokens to request from the LLM.
LLM_MAX_TOKENS=512

# Request timeout in milliseconds.
LLM_TIMEOUT_MS=15000

# Optional: Anthropic-specific settings.
# These are only needed when LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Optional: OpenAI-compatible provider settings.
# These can override the generic LLM_* values when needed.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# JSON file-backed store location.
# The default is ./data/reports.json.
# STORE_PATH=./data/reports.json

# Optional directory for local runtime data.
# DATA_DIR=./data

# Optional explicit file locations.
# SESSIONS_FILE=./data/sessions.json
# REPORTS_FILE=./data/reports.json

# Optional debounce interval for writing store updates to disk.
# STORE_WRITE_INTERVAL_MS=1000

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# Optional logging level.
# LOG_LEVEL=info

# Optional maximum number of session events accepted per ingest request.
# MAX_SESSION_EVENTS=500

# Optional salt used to make inkblot generation deterministic per deployment.
# INKBLOT_SEED_SALT=queue-rorschach